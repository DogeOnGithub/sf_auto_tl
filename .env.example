# 默认额度的凭证由「模型池」提供，在前端星裔（管理员）页面维护，不再由环境变量配置。
# 下面三项只用于池化改造上线时的一次性种子导入：池为空且 LLM_API_KEY 有值时，
# 后端启动会自动把它导入成第一个池成员。导入完成后这三项即可删除。
LLM_API_KEY=your-llm-api-key
# 只填到 /v1 这一层，不要带 /chat/completions，SDK 会自己拼端点
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 模型池调度参数
# 用量滚动窗口天数。引擎按「窗口内已消耗 token ÷ 配比」最小优先挑成员，
# 目的是分散成本而不是提速（任务内批次本来就是串行的）。
# 后端展示统计也用这个值，两侧必须一致
LLM_POOL_USAGE_WINDOW_DAYS=7
# 引擎缓存池配置的时长（秒）。管理页改完配置最多这么久生效
LLM_POOL_CONFIG_TTL_SECONDS=60
# 累计多少次请求就把用量增量上报一次。只在任务结束上报的话，
# 跑几小时的任务中途引擎重启会丢掉全部用量
LLM_POOL_STAT_FLUSH_REQUESTS=100
# 单个批次内最多切换几次成员。切换与重试是两个维度，
# 不封顶三成员池会把 3 次重试放大成 9 次付费请求
LLM_POOL_MAX_MEMBER_SWITCHES=2
# 各类错误的成员冷却时长（秒）。限流恢复快；鉴权失效、余额不足、
# 模型名不存在都要人工介入，冷却给长一些，避免每个批次都去撞同一个坏成员
LLM_POOL_COOLDOWN_RATE_LIMIT=60
LLM_POOL_COOLDOWN_AUTH=1800
LLM_POOL_COOLDOWN_QUOTA=1800
LLM_POOL_COOLDOWN_MODEL_NOT_FOUND=1800
LLM_POOL_COOLDOWN_TRANSIENT=15

# LLM 调优参数（都有默认值，不确定就别改）
# 单批输出 token 预算，批次字符上限按它反推（3200 / 0.4 = 8000 字符）
# 常见 OpenAI 兼容服务的默认输出上限低到 4096，预算留在 4096 的八成以内才不会频繁截断
LLM_OUTPUT_TOKEN_BUDGET=3200
# 每批字符数 / 记录数上限，谁先触顶就切批
LLM_MAX_BATCH_CHARS=8000
LLM_MAX_BATCH_RECORDS=80
# 单次响应输出 token 上限。留空表示不下发该参数、由 provider 用自己的默认值。
# 只有在确认目标模型允许该值时才填，填超了会直接 400 导致整批词条翻不出来。
# LLM_MAX_OUTPUT_TOKENS=8192
# 单次请求超时（秒）
LLM_REQUEST_TIMEOUT=300
# 响应被截断时对半拆分重试的最大深度
LLM_MAX_SPLIT_DEPTH=4
# 单个 prompt 最多携带的词典条数（已按批过滤，这是兜底上限）
LLM_MAX_PROMPT_DICT_ENTRIES=200
# 术语提取：采样字符数上限与返回条数上限
LLM_GLOSSARY_MAX_CHARS=60000
LLM_GLOSSARY_MAX_TERMS=150

# 已汉化文件护栏：中文词条占比达到该阈值就判定文件已经汉化过、直接拒绝翻译。
# 调低会更激进地拦截，但可能误杀「汉化了一部分、还有真实工作量」的半成品。
ALREADY_TRANSLATED_RATIO=0.98
# 占比判定生效所需的最小样本量，样本不足时改由「逐条过滤后无待翻词条」兜底
ALREADY_TRANSLATED_MIN_RECORDS=30

# 引擎日志级别。INFO 才能看到 token 用量汇总，逐条原文译文在 DEBUG
LOG_LEVEL=INFO

# 腾讯云 COS 配置
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=your-bucket-name
COS_BASE_URL=https://your-bucket-name.cos.ap-guangzhou.myqcloud.com

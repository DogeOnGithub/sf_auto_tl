LLM_API_KEY=your-llm-api-key
# 只填到 /v1 这一层，不要带 /chat/completions，SDK 会自己拼端点
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# LLM 调优参数（都有默认值，不确定就别改）
# 单批输出 token 预算，批次字符上限按它反推（3200 / 0.4 = 8000 字符）
# 常见 OpenAI 兼容服务的默认输出上限低到 4096，预算留在 4096 的八成以内才不会频繁截断
LLM_OUTPUT_TOKEN_BUDGET=3200
# 每批字符数 / 记录数上限，谁先触顶就切批
LLM_MAX_BATCH_CHARS=8000
LLM_MAX_BATCH_RECORDS=80
# 单次响应输出 token 上限。留空表示不下发该参数、由 provider 用自己的默认值。
# 只有在确认目标模型允许该值时才填，填超了会直接 400 导致整批词条翻不出来。
# LLM_MAX_OUTPUT_TOKENS=8192
# 单次请求超时（秒）
LLM_REQUEST_TIMEOUT=300
# 响应被截断时对半拆分重试的最大深度
LLM_MAX_SPLIT_DEPTH=4
# 单个 prompt 最多携带的词典条数（已按批过滤，这是兜底上限）
LLM_MAX_PROMPT_DICT_ENTRIES=200
# 术语提取：采样字符数上限与返回条数上限
LLM_GLOSSARY_MAX_CHARS=60000
LLM_GLOSSARY_MAX_TERMS=150

# 引擎日志级别。INFO 才能看到 token 用量汇总，逐条原文译文在 DEBUG
LOG_LEVEL=INFO

# 腾讯云 COS 配置
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=your-bucket-name
COS_BASE_URL=https://your-bucket-name.cos.ap-guangzhou.myqcloud.com
